# OpenRouter API key — get one at https://openrouter.ai
OPENROUTER_API_KEY=your_key_here

# Groq API key — get one at https://console.groq.com (alternative to OpenRouter)
GROQ_API_KEY=your_groq_api_key

# Brevo email API — optional, digest is emailed after each run if set
# API key is found in your Brevo account under SMTP & API → API Keys
BREVO_API_KEY=your_brevo_api_key
# Sender must be a verified address in your Brevo account
BREVO_FROM_EMAIL=you@example.com
BREVO_FROM_NAME=Agentic News Composer
# Comma-separated list of recipient email addresses
BREVO_TO_EMAILS=you@example.com
